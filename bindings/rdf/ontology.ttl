@prefix org1: <https://example.org/organizational-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

org1:class%2Forganization_model.examples.CapabilityAssessment a owl:Class ;
    rdfs:label "CapabilityAssessment" ;
    rdfs:comment "Capability concerns the defined work, not an arbitrary capability name." ;
    rdfs:seeAlso org1:shape%2Forganization_model.examples.CapabilityAssessment ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Capability%2Fdimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom org1:class%2Forganization_model.examples.BusinessNeed ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Value%2Frelative_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom org1:class%2Forganization_model.examples.RefundService ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Value%2Fsubject ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Value%2Fassessment ],
        org1:class%2Forganization_model.value.Capability%5BRefundService%2C%20BusinessNeed%2C%20CapabilityWorth%5D .

org1:class%2Forganization_model.examples.CapabilityAssessment%2Ffield%2Fassessment owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( org1:class%2Forganization_model.examples.CapabilityAssessment%2Ffield%2Fassessment%2Fchoice%2F0 org1:class%2Forganization_model.examples.CapabilityAssessment%2Ffield%2Fassessment%2Fchoice%2F1 ) ] .

org1:class%2Forganization_model.examples.ContinuousService a owl:Class ;
    rdfs:label "ContinuousService" ;
    rdfs:comment "A purpose can concern continued satisfaction, not only a new state." ;
    rdfs:seeAlso org1:shape%2Forganization_model.examples.ContinuousService ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.work.Purpose%2Froot ],
        org1:class%2Forganization_model.work.Purpose .

org1:class%2Forganization_model.examples.EconomicAssessment a owl:Class ;
    rdfs:label "EconomicAssessment" ;
    rdfs:comment "A monetary assessment with a fixed, validated denomination." ;
    rdfs:seeAlso org1:shape%2Forganization_model.examples.EconomicAssessment ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom org1:class%2Forganization_model.examples.BusinessNeed ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Value%2Frelative_to ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Value%2Fassessment ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Economic%2Fdimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom org1:class%2Forganization_model.examples.RefundService ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.Value%2Fsubject ],
        org1:class%2Forganization_model.value.Economic%5BRefundService%2C%20BusinessNeed%2C%20Assessment%5Borganization_model.value.FinancialChange%5BDollars%5D%5D%5D .

org1:class%2Forganization_model.examples.EconomicAssessment%2Ffield%2Fassessment owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( org1:class%2Forganization_model.examples.EconomicAssessment%2Ffield%2Fassessment%2Fchoice%2F0 org1:class%2Forganization_model.examples.EconomicAssessment%2Ffield%2Fassessment%2Fchoice%2F1 org1:class%2Forganization_model.examples.EconomicAssessment%2Ffield%2Fassessment%2Fchoice%2F2 ) ] .

org1:class%2Forganization_model.examples.ExpiredReview a owl:Class ;
    rdfs:label "ExpiredReview" ;
    rdfs:comment """One admissible input/outcome case of a unit of organizational work.

Where inputs and outcomes are correlated, declare separate complete subclasses
and a tagged union of those subclasses. The declaration is not an occurrence.""" ;
    rdfs:seeAlso org1:shape%2Forganization_model.examples.ExpiredReview ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom org1:class%2Forganization_model.work.ProducedOutcome%5BExpiredState%5D ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.work.Activity%2Foutcomes ],
        [ a owl:Restriction ;
            owl:allValuesFrom org1:class%2Forganization_model.work.Prohibition%5BExpired%2C%20RefundAction%5D ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.work.Activity%2Finputs ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.examples.ExpiredReview%2Fcase ],
        org1:class%2Forganization_model.work.Activity%5BProhibition%5BExpired%2C%20RefundAction%5D%2C%20ProducedOutcome%5BExpiredState%5D%5D .

org1:class%2Forganization_model.examples.GainedAbility a owl:Class ;
    rdfs:label "GainedAbility" ;
    rdfs:comment """!!! abstract "Usage Documentation"
    [Models](../concepts/models.md)

A base class for creating Pydantic models.

Attributes:
    __class_vars__: The names of the class variables defined on the model.
    __private_attributes__: Metadata about the private attributes of the model.
    __signature__: The synthesized `__init__` [`Signature`][inspect.Signature] of the model.

    __pydantic_complete__: Whether model building is completed, or if there are still undefined fields.
    __pydantic_core_schema__: The core schema of the model.
    __pydantic_custom_init__: Whether the model has a custom `__init__` function.
    __pydantic_decorators__: Metadata containing the decorators defined on the model.
        This replaces `Model.__validators__` and `Model.__root_validators__` from Pydantic V1.
    __pydantic_generic_metadata__: A dictionary containing metadata about generic Pydantic models.
        The `origin` and `args` items map to the [`__origin__`][genericalias.__origin__]
        and [`__args__`][genericalias.__args__] attributes of [generic aliases][types-genericalias],
        and the `parameter` item maps to the `__parameter__` attribute of generic classes.
    __pydantic_parent_namespace__: Parent namespace of the model, used for automatic rebuilding of models.
    __pydantic_post_init__: The name of the post-init method for the model, if defined.
    __pydantic_root_model__: Whether the model is a [`RootModel`][pydantic.root_model.RootModel].
    __pydantic_serializer__: The `pydantic-core` `SchemaSerializer` used to dump instances of the model.
    __pydantic_validator__: The `pydantic-core` `SchemaValidator` used to validate instances of the model.

    __pydantic_fields__: A dictionary of field names and their corresponding [`FieldInfo`][pydantic.fields.FieldInfo] objects.
    __pydantic_computed_fields__: A dictionary of computed field names and their corresponding [`ComputedFieldInfo`][pydantic.fields.ComputedFieldInfo] objects.

    __pydantic_extra__: A dictionary containing extra values, if [`extra`][pydantic.config.ConfigDict.extra]
        is set to `'allow'`.
    __pydantic_fields_set__: The names of fields explicitly set during instantiation.
    __pydantic_private__: Values of private attributes set on the model instance.""" ;
    rdfs:seeAlso org1:shape%2Forganization_model.examples.GainedAbility ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.AbilityChange%2Foperation ],
        [ a owl:Restriction ;
            owl:allValuesFrom org1:class%2Forganization_model.examples.RefundProcess ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.AbilityChange%2Factivity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.AbilityChange%2Fkind ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.value.AbilityChange%2Fevidence ],
        org1:class%2Forganization_model.value.AbilityChange%5BRefundProcess%2C%20Literal%5B%27demonstrated%27%5D%5D .

org1:class%2Forganization_model.examples.GroupedPurpose a owl:Class ;
    rdfs:label "GroupedPurpose" ;
    rdfs:comment "Two required, nonempty, independently typed outcome groups." ;
    rdfs:seeAlso org1:shape%2Forganization_model.examples.GroupedPurpose ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty org1:property%2Forganization_model.work.Purpose%2Froot ],
        org1:class%2Forganization_model.work.Purpose .

