org1:shape%2Forganization_model.examples.GroupedPurpose%2Ffield%2Froot a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:hasValue () ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ( rdf:rest rdf:rest ) ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node org1:shape%2Forganization_model.examples.GroupedPurpose%2Ffield%2Froot%2Fposition%2F1 ;
            sh:path ( rdf:rest rdf:first ) ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node org1:shape%2Forganization_model.examples.GroupedPurpose%2Ffield%2Froot%2Fposition%2F0 ;
            sh:path ( rdf:first ) ] ;
    sh:sparql [ sh:message "RDF collection must terminate at rdf:nil, have one item and next per cell, and contain no cycles." ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT $this WHERE {
 FILTER (
  NOT EXISTS { $this rdf:rest* rdf:nil }
  || EXISTS { $this rdf:rest+ $this }
  || EXISTS { $this rdf:rest* ?c . FILTER(?c != rdf:nil)
              FILTER NOT EXISTS { ?c rdf:first ?item ; rdf:rest ?tail } }
  || EXISTS { $this rdf:rest* ?c . ?c rdf:first ?x, ?y . FILTER(?x != ?y) }
  || EXISTS { $this rdf:rest* ?c . ?c rdf:rest ?x, ?y . FILTER(?x != ?y) }
 )
}""" ] .

