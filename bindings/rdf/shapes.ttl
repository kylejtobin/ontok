            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this WHERE {
  $this rdf:type <https://example.org/organizational-ontology#class%2Forganization_model.work.Responsibility> ; ?predicate ?value .
  FILTER (?predicate NOT IN (<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>, <https://example.org/organizational-ontology#property%2Forganization_model.work.Responsibility%2Froot>))
  FILTER NOT EXISTS {
    $this rdf:type ?moreSpecific .
    ?moreSpecific rdfs:subClassOf+ <https://example.org/organizational-ontology#class%2Forganization_model.work.Responsibility> .
    FILTER (?moreSpecific != <https://example.org/organizational-ontology#class%2Forganization_model.work.Responsibility>)
  }
}""" ] ;
    sh:targetClass org1:class%2Forganization_model.work.Responsibility .

org1:shape%2Forganization_model.work.ResponsibilityTransfer a sh:NodeShape ;
    sh:node org1:shape%2Forganization_model.work.ResponsibilityTransfer ;
    sh:targetClass org1:class%2Forganization_model.work.ResponsibilityTransfer .

org1:shape%2Forganization_model.work.Role%2Ffield%2Froot a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:minCount 1 ;
            sh:node org1:shape%2Forganization_model.work.Responsibility ;
            sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ;
    sh:sparql [ sh:message "RDF collection must terminate at rdf:nil, have one item and next per cell, and contain no cycles." ;
            sh:select """PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT $this WHERE {
 FILTER (
  NOT EXISTS { $this rdf:rest* rdf:nil }
  || EXISTS { $this rdf:rest+ $this }
  || EXISTS { $this rdf:rest* ?c . FILTER(?c != rdf:nil)
              FILTER NOT EXISTS { ?c rdf:first ?item ; rdf:rest ?tail } }
  || EXISTS { $this rdf:rest* ?c . ?c rdf:first ?x, ?y . FILTER(?x != ?y) }
  || EXISTS { $this rdf:rest* ?c . ?c rdf:rest ?x, ?y . FILTER(?x != ?y) }
 )
}""" ] .

